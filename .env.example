# Seu Fisio API
SEUFISIO_USERNAME=email@example.com
SEUFISIO_PASSWORD=your_password
SEUFISIO_CLIENT_SECRET=your_client_secret
SEUFISIO_STUDIO_ID=your_studio_id
SEUFISIO_VERSION_APP=26

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=your_channel_id

# WhatsApp
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=your_connected_instance
WHATSAPP_WEBHOOK_PORT=3333
WHATSAPP_WEBHOOK_PATH=/webhooks/whatsapp
WHATSAPP_TIMEOUT_MS=15000
WHATSAPP_BUSINESS_NAME=MovArt
WHATSAPP_CONTACT_PHONE=(11) 99999-9999
WHATSAPP_PAYMENT_URL=https://your-payment-link.example.com
WHATSAPP_PIX_KEY=59.697.431/0001-00
WHATSAPP_DRY_RUN=false

# Cron Schedules (format: minute hour day month weekday)
# Default: 8:00 AM every day
CRON_BIRTHDAY=0 8 * * *
# Default: Monday at 8:00 AM
CRON_PLAN_EXPIRATION=0 8 * * 1
# Default: 8:00 AM every day
CRON_INVOICES=0 8 * * *
# Default: 9:00 AM every day
CRON_WHATSAPP_REMINDERS=0 9 * * *
# Default: Every 5 minutes
CRON_CHECKIN=*/5 * * * *

# Plan Expiration Settings
PLAN_EXPIRATION_DAYS=14

# Check-in Settings
CHECKIN_ALLOWED_TYPES=Pilates 1x na Semana,Pilates 2x na Semana,Pilates 3x na Semana
CHECKIN_ALLOWED_STATUSES=1
CHECKIN_MINUTES_AFTER_START=10
